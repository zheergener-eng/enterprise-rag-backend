# ============================================================
# 环境变量示例文件
# 使用方式：复制为 .env 并填入真实值（.env 已被 .gitignore 忽略）
#   cp .env.example .env
# 注意：真实 API Key 只放在本地 .env，绝不提交到仓库或硬编码进代码。
# ============================================================

# ----- DeepSeek（OpenAI 兼容协议）-----
DEEPSEEK_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxx
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat

# ----- Redis Stack（向量检索 + 会话存储）-----
REDIS_URL=redis://localhost:6379
# RediSearch 向量索引名称
REDIS_INDEX_NAME=rag:index
# 向量 chunk key 前缀（生产默认 chunk:；测试 / Evaluation 请用独立前缀隔离）
REDIS_CHUNK_PREFIX=chunk:
# 会话 key 前缀（生产默认 session:；测试 / Evaluation 请用独立前缀隔离）
REDIS_SESSION_PREFIX=session:

# ----- Embedding（sentence-transformers）-----
# 首次使用会自动联网下载该模型到 HuggingFace 缓存目录
EMBEDDING_MODEL=BAAI/bge-small-zh-v1.5
# 与所选模型输出维度保持一致（bge-small-zh-v1.5 为 512）
EMBEDDING_DIM=512

# ----- Reranker（Cross-Encoder 精排）-----
# 首次使用会自动联网下载该模型到 HuggingFace 缓存目录
RERANKER_MODEL=BAAI/bge-reranker-base

# ----- 切片策略 -----
# 目标片长（字符数）
CHUNK_SIZE=600
# 相邻片重叠（字符数）
CHUNK_OVERLAP=100

# ----- 两阶段检索（Recall → Rerank）-----
# Redis 向量召回数量（Rerank 前的候选池）
RECALL_TOP_N=10
# Rerank 后最终送入 RAG 的片段数量（须 <= RECALL_TOP_N）
RERANK_TOP_K=3

# ----- Relevance Gate（相关性门槛）-----
# top-1 候选的 rerank_score 低于该阈值时，判定知识库不足以作答，返回统一 no-answer。
# 该值经 Evaluation v2 校准（见 evaluation/reports/evaluation_v2.md 的
# 「Relevance Threshold Selection」章节）：在 FP=5 / FN=0 / Recall=100% 的折中点上选定 0.8。
# 注意：rerank_score 是 Cross-Encoder sigmoid 输出，只表示 query-chunk 语义相关性，
# 不能解释为「置信概率」。此阈值是 benchmark-dependent 的工程折中值，并非理论或普适最优；
# 当知识库、Embedding、Reranker 或真实业务 query 分布变化时应重新校准。
RERANK_RELEVANCE_THRESHOLD=0.8

# ----- 会话 -----
# 会话历史自动过期时间（秒），默认 2 小时
SESSION_TTL_SECONDS=7200
# 送入 LLM 的最近历史消息条数（完整历史仍完整保留在 Redis 中）
MAX_HISTORY_MESSAGES=10

# ----- 文件上传 -----
# 单文件上传大小上限（MB），超过返回 413。仅用于 .md / .txt 文本知识库文档。
MAX_UPLOAD_FILE_SIZE_MB=5
